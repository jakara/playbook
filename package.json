{
  "name": "@playbook/core",
  "version": "0.11.1",
  "private": true,
  "type": "module",
  "description": "Playbook desktop player and AI-native authoring skill",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check:examples": "tsc -p tsconfig.examples.json",
    "test:unit": "node --test tests/*.test.mjs",
    "test:examples": "playwright test -c examples/playwright.config.ts",
    "test:negative": "node tests/negative-check.mjs",
    "check": "node scripts/check-versions.mjs && npm run build && npm run check:examples && npm run test:unit && npm run test:examples && npm run test:negative",
    "start": "npm run electron:install && npm run desktop:build && electron .",
    "desktop:build": "npm run build && node scripts/build-desktop.mjs",
    "desktop:check": "node --test tests/desktop-*.test.mjs tests/skill-installer.test.mjs",
    "desktop:smoke": "npm run electron:install && node scripts/hybrid-smoke.mjs",
    "package:mac": "npm run electron:install && npm run desktop:build && electron-builder --mac dir dmg zip --arm64 --publish never",
    "test:pptx": "node scripts/pptx-smoke.mjs",
    "icons": "node scripts/build-icons.mjs",
    "electron:install": "install-electron"
  },
  "devDependencies": {
    "@types/node": "24.0.0",
    "electron": "45.0.0",
    "electron-builder": "26.15.3",
    "vite": "8.3.5"
  },
  "main": "build/main.cjs",
  "dependencies": {
    "@playwright/test": "1.58.2",
    "driver.js": "1.10.2",
    "esbuild": "0.28.2",
    "jszip": "3.10.1",
    "playwright": "1.58.2",
    "pptxgenjs": "4.0.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "5.9.3"
  },
  "build": {
    "electronDist": "node_modules/electron/dist",
    "appId": "com.playbook.desktop",
    "productName": "Playbook",
    "asar": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "build/**/*",
      "dist/**/*",
      "desktop/presentation/**/*",
      "package.json",
      "skills/**/*",
      "examples/starter/**/*",
      "examples/tutorial/**/*",
      "assets/**/*",
      "LICENSE",
      "install.md"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "identity": null,
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "assets/playbook.icns"
    },
    "npmRebuild": false,
    "extraResources": [
      {
        "from": "dist/index.d.ts",
        "to": "app/dist/index.d.ts"
      }
    ],
    "artifactName": "Playbook-macos-${arch}.${ext}"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jakara/playbook.git"
  },
  "author": "Playbook contributors"
}
